{
  "properties": {
    "activities": [
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "SELECT count(*) as count FROM @{variables('MainControlTableName')} where TopLevelPipelineName='@{pipeline().PipelineName}' and CopyEnabled = 1 ",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "connectionSettings": {
              "name": "PipelineControl",
              "properties": {
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "artifactId": "67f48c8a-3935-b59f-4eb3-9018a60de7c2",
                  "workspaceId": "00000000-0000-0000-0000-000000000000"
                },
                "externalReferences": {
                  "connection": "21e098c8-37ce-468a-b1bd-787c9d6750dc"
                },
                "annotations": []
              }
            },
            "annotations": []
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "GetSumOfObjectsToCopy",
        "description": "Count the total number of objects (tables etc.) required to be copied in this run.",
        "dependsOn": [
          {
            "activity": "Set possible DEBUG",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "BACKUP Main Control Table",
            "dependencyConditions": [
              "Completed"
            ]
          }
        ]
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@range(0, add(div(activity('GetSumOfObjectsToCopy').output.firstRow.count,\n                    pipeline().parameters.MaxNumberOfConcurrentTasks),\n                    if(equals(mod(activity('GetSumOfObjectsToCopy').output.firstRow.count,\n                    pipeline().parameters.MaxNumberOfConcurrentTasks), 0), 0, 1)))",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "InvokePipeline",
              "typeProperties": {
                "parameters": {
                  "MaxNumberOfObjectsReturnedFromLookupActivity": {
                    "value": "@pipeline().parameters.MaxNumberOfObjectsReturnedFromLookupActivity",
                    "type": "Expression"
                  },
                  "TopLevelPipelineName": {
                    "value": "@pipeline().PipelineName",
                    "type": "Expression"
                  },
                  "CurrentSequentialNumberOfBatch": {
                    "value": "@item()",
                    "type": "Expression"
                  },
                  "SumOfObjectsToCopy": {
                    "value": "@activity('GetSumOfObjectsToCopy').output.firstRow.count",
                    "type": "Expression"
                  },
                  "SumOfObjectsToCopyForCurrentBatch": {
                    "value": "@min(pipeline().parameters.MaxNumberOfConcurrentTasks, activity('GetSumOfObjectsToCopy').output.firstRow.count)",
                    "type": "Expression"
                  },
                  "MainControlTableName": {
                    "value": "@variables('MainControlTableName')",
                    "type": "Expression"
                  },
                  "ScheduleID": {
                    "value": "@pipeline().TriggerId",
                    "type": "Expression"
                  },
                  "Debug": {
                    "value": "@pipeline().parameters.Debug",
                    "type": "Expression"
                  }
                },
                "waitOnCompletion": true,
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "pipelineId": "392d5548-ab6e-bd95-4ff4-a857350e0122",
                "operationType": "InvokeFabricPipeline"
              },
              "externalReferences": {
                "connection": "3dce77d5-282e-4068-99ee-ae8373da6a12"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "CopyObjectsInOneBatch",
              "description": "Execute another pipeline to copy one batch of objects. The objects belonging to this batch will be copied parallelly.",
              "dependsOn": []
            }
          ]
        },
        "name": "CopyBatchesOfObjectsSequentially",
        "description": "Come up with the number of sequential batches based on the max allowed concurrent copy tasks, and then execute another pipeline to copy different batches sequentially.",
        "dependsOn": [
          {
            "activity": "GetSumOfObjectsToCopy",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "MainControlTableName",
          "value": {
            "value": "@if(equals(pipeline().parameters.Debug, 1), concat(pipeline().parameters.MainControlTableName, '_DEBUG'), pipeline().parameters.MainControlTableName)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Set possible DEBUG",
        "dependsOn": []
      },
      {
        "type": "SqlServerStoredProcedure",
        "typeProperties": {
          "storedProcedureName": "[dbo].[BACKUP_MainControlTable]"
        },
        "connectionSettings": {
          "name": "PipelineControl",
          "properties": {
            "type": "FabricSqlDatabase",
            "typeProperties": {
              "artifactId": "67f48c8a-3935-b59f-4eb3-9018a60de7c2",
              "workspaceId": "00000000-0000-0000-0000-000000000000"
            },
            "externalReferences": {
              "connection": "21e098c8-37ce-468a-b1bd-787c9d6750dc"
            },
            "annotations": []
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "BACKUP Main Control Table",
        "dependsOn": []
      }
    ],
    "parameters": {
      "MaxNumberOfObjectsReturnedFromLookupActivity": {
        "type": "int",
        "defaultValue": 5000
      },
      "MaxNumberOfConcurrentTasks": {
        "type": "int",
        "defaultValue": 20
      },
      "MainControlTableName": {
        "type": "string",
        "defaultValue": "dbo.MainControlTable_JSON_FLATTENED"
      },
      "Debug": {
        "type": "int",
        "defaultValue": 0
      }
    },
    "variables": {
      "MainControlTableName": {
        "type": "String",
        "defaultValue": "Foo"
      }
    }
  }
}